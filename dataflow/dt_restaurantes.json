{
	"name": "dt_restaurantes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "restaurantes_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          restaurante_id as string,",
				"          nombre_restaurante as string,",
				"          tipo_cocina as string,",
				"          calificacion_promedio as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(restaurante_id = trim(upper(restaurante_id)),",
				"          nombre_restaurante = trim(initCap(nombre_restaurante)),",
				"          tipo_cocina = trim(initCap(tipo_cocina)),",
				"          calificacion_promedio = toDecimal(calificacion_promedio, 3, 2),",
				"          activo = iif(activo == 'true' || activo == '1', 1, 0)) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(restaurante_id) && !isNull(nombre_restaurante),",
				"     disjoint: false) ~> split1@(Validas, Rechazadas)",
				"split1@Validas aggregate(groupBy(restaurante_id),",
				"     nombre_restaurante = first(nombre_restaurante),",
				"          tipo_cocina = first(tipo_cocina),",
				"          calificacion_promedio = first(calificacion_promedio),",
				"          activo = first(activo)) ~> aggregate1",
				"aggregate1 derive(calificacion_promedio = toDecimal(calificacion_promedio, 3, 2)) ~> derivedColumn2"
			]
		}
	}
}