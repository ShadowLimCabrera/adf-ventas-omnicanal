{
	"name": "dt_detalle_pedidos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "detalle_pedidos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          detalle_id as string,",
				"          pedido_id as string,",
				"          producto_id as string,",
				"          cantidad as string,",
				"          precio_unitario as string,",
				"          descuento_linea as string,",
				"          total_linea as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(detalle_id = trim(upper(detalle_id)),",
				"          pedido_id = trim(upper(pedido_id)),",
				"          producto_id = trim(upper(producto_id)),",
				"          cantidad = toInteger(cantidad),",
				"          precio_unitario = toDecimal(precio_unitario, 12, 2),",
				"          descuento_linea = toDecimal(descuento_linea, 5, 2),",
				"          total_linea = toDecimal(total_linea, 12, 2)) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(detalle_id) && !isNull(pedido_id) && !isNull(producto_id) && cantidad > 0 && precio_unitario >= 0,",
				"     disjoint: false) ~> split1@(Viable, Descartados)",
				"split1@Viable aggregate(groupBy(detalle_id),",
				"     pedido_id = first(pedido_id),",
				"          producto_id = first(producto_id),",
				"          cantidad = first(cantidad),",
				"          precio_unitario = first(precio_unitario),",
				"          descuento_linea = first(descuento_linea),",
				"          total_linea = first(total_linea)) ~> aggregate1"
			]
		}
	}
}