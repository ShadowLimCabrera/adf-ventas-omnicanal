{
	"name": "dt_promociones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "promociones_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          fecha_inicio as string,",
				"          fecha_fin as string,",
				"          porcentaje_descuento as string,",
				"          canal_aplicable as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(promocion_id = trim(upper(promocion_id)),",
				"          nombre_promocion = trim(initCap(nombre_promocion)),",
				"          fecha_inicio = toDate(fecha_inicio, 'yyyy-MM-dd'),",
				"          fecha_fin = toDate(fecha_fin, 'yyyy-MM-dd'),",
				"          porcentaje_descuento = toDecimal(porcentaje_descuento, 5, 2),",
				"          canal_aplicable = trim(initCap(canal_aplicable))) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(promocion_id) && !isNull(nombre_promocion),",
				"     disjoint: false) ~> split1@(Viable, Rechazados)",
				"split1@Viable aggregate(groupBy(promocion_id),",
				"     nombre_promocion = first(nombre_promocion),",
				"          fecha_inicio = first(fecha_inicio),",
				"          fecha_fin = first(fecha_fin),",
				"          porcentaje_descuento = first(porcentaje_descuento),",
				"          canal_aplicable = first(canal_aplicable)) ~> aggregate1",
				"aggregate1 derive(porcentaje_descuento = toDecimal(porcentaje_descuento, 5, 2)) ~> derivedColumn2"
			]
		}
	}
}