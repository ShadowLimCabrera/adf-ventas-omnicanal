{
	"name": "dt_repartidores",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "repartidores_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          repartidor_id as string,",
				"          nombre_repartidor as string,",
				"          tipo_vehiculo as string,",
				"          ciudad_base as string,",
				"          fecha_alta as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(repartidor_id = trim(upper(repartidor_id)),",
				"          nombre_repartidor = trim(initCap(nombre_repartidor)),",
				"          tipo_vehiculo = trim(initCap(tipo_vehiculo)),",
				"          ciudad_base = trim(initCap(ciudad_base)),",
				"          fecha_alta = toDate(fecha_alta, 'yyyy-MM-dd'),",
				"          activo = iif(activo == 'true' || activo == '1', 1, 0)) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(repartidor_id) && !isNull(nombre_repartidor),",
				"     disjoint: false) ~> split1@(Viables, Rechazados)",
				"split1@Viables aggregate(groupBy(repartidor_id),",
				"     nombre_repartidor = first(nombre_repartidor),",
				"          tipo_vehiculo = first(tipo_vehiculo),",
				"          ciudad_base = first(ciudad_base),",
				"          fecha_alta = first(fecha_alta),",
				"          activo = first(activo)) ~> aggregate1"
			]
		}
	}
}