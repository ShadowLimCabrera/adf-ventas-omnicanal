{
	"name": "dt_pagos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "pagos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          pago_id as string,",
				"          pedido_id as string,",
				"          fecha_pago as string,",
				"          metodo_pago as string,",
				"          estado_pago as string,",
				"          monto_pagado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(pago_id = trim(upper(pago_id)),",
				"          pedido_id = trim(upper(pedido_id)),",
				"          fecha_pago = toDate(fecha_pago, 'yyyy-MM-dd'),",
				"          metodo_pago = trim(initCap(metodo_pago)),",
				"          estado_pago = trim(initCap(estado_pago)),",
				"          monto_pagado = toDecimal(monto_pagado, 12, 2)) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(pago_id) && !isNull(pedido_id) && !isNull(monto_pagado) && monto_pagado >= 0,",
				"     disjoint: false) ~> split1@(Validos, Rechazados)",
				"split1@Validos aggregate(groupBy(pago_id),",
				"     pedido_id = first(pedido_id),",
				"          fecha_pago = first(fecha_pago),",
				"          metodo_pago = first(metodo_pago),",
				"          estado_pago = first(estado_pago),",
				"          monto_pagado = first(monto_pagado)) ~> aggregate1"
			]
		}
	}
}