{
	"name": "dt_sucursales",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sucursales_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"parameters{",
				"     parámetro1 as string",
				"}",
				"source(output(",
				"          sucursal_id as string,",
				"          restaurante_id as string,",
				"          nombre_sucursal as string,",
				"          ciudad as string,",
				"          zona as string,",
				"          direccion as string,",
				"          capacidad_mesas as string,",
				"          tiene_delivery as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(sucursal_id = trim(upper(sucursal_id)),",
				"          restaurante_id = trim(upper(restaurante_id)),",
				"          nombre_sucursal = trim(initCap(nombre_sucursal)),",
				"          ciudad = trim(initCap(ciudad)),",
				"          zona = trim(initCap(zona)),",
				"          direccion = trim(direccion),",
				"          capacidad_mesas = toInteger(capacidad_mesas),",
				"          tiene_delivery = iif(tiene_delivery == 'true' || tiene_delivery == '1', 1, 0)) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(sucursal_id) && !isNull(restaurante_id) && !isNull(nombre_sucursal),",
				"     disjoint: false) ~> split1@(Validas, Rechazadas)",
				"split1@Validas aggregate(groupBy(sucursal_id),",
				"     restaurante_id = first(restaurante_id),",
				"          nombre_sucursal = first(nombre_sucursal),",
				"          ciudad = first(ciudad),",
				"          zona = first(zona),",
				"          direccion = first(direccion),",
				"          capacidad_mesas = first(capacidad_mesas),",
				"          tiene_delivery = first(tiene_delivery)) ~> aggregate1",
				"aggregate1 derive(capacidad_mesas = toInteger(capacidad_mesas)) ~> derivedColumn2"
			]
		}
	}
}